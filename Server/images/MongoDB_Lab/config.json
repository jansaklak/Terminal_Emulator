{
    "session": {
        "base_name": "mongodb_lab",
        "image": "mongo:6.0",
        "network": "lab-net",
        "database": "labdb",
        "user": "admin",
        "password": "adminpassword",
        "seed_sql": "resources/init.js",
        "seed_target": "/docker-entrypoint-initdb.d/init.js",
        "run_command": [
            "run",
            "-d",
            "--pids-limit",
            "100",
            "--memory",
            "512m",
            "--memory-swap",
            "512m",
            "--name",
            "{container_name}",
            "--network",
            "{network}",
            "-e",
            "MONGO_INITDB_ROOT_USERNAME={user}",
            "-e",
            "MONGO_INITDB_ROOT_PASSWORD={password}",
            "-e",
            "MONGO_INITDB_DATABASE={database}",
            "-v",
            "{data_volume}:/data/db",
            "-v",
            "{seed_sql_host_path}:{seed_target}:ro",
            "{image}"
        ],
        "attach_command": [
            "sh",
            "-c",
            "echo 'Czekam na uruchomienie MongoDB...'; i=0; max=240; until mongosh --username {user} --password {password} --authenticationDatabase admin --eval 'db.runCommand({ping:1})' >/dev/null 2>&1 || [ \"$i\" -ge \"$max\" ]; do sleep 1; i=$((i+1)); done; if [ \"$i\" -ge \"$max\" ]; then echo 'MongoDB nie uruchomił się w czasie' >&2; fi; exec mongosh --username {user} --password {password} --authenticationDatabase admin {database}"
        ]
    },
    "description": "MongoDB - Baza dokumentowa"
}