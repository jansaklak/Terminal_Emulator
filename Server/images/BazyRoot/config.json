{
    "session": {
        "base_name": "mysql_lab_root",
        "image": "mysql:8.0",
        "network": "lab-net",
        "database": "labdb",
        "user": "labuser",
        "password": "labpass",
        "root_password": "rootpass",
        "seed_sql": "resources/init.sql",
        "seed_target": "/docker-entrypoint-initdb.d/init.sql",
        "run_command": [
            "run",
            "-d",
            "--name",
            "{container_name}",
            "--network",
            "{network}",
            "-e",
            "MYSQL_ROOT_PASSWORD={root_password}",
            "-e",
            "MYSQL_DATABASE={database}",
            "-e",
            "MYSQL_USER={user}",
            "-e",
            "MYSQL_PASSWORD={password}",
            "-v",
            "{data_volume}:/var/lib/mysql",
            "-v",
            "{seed_sql_host_path}:{seed_target}:ro",
            "{image}"
        ],
        "attach_command": [
            "sh",
            "-c",
            "echo 'Czekam na uruchomienie MySQL (root)...'; i=0; max=30; until mysqladmin ping -h127.0.0.1 -uroot -p{root_password} --silent >/dev/null 2>&1 || [ \"$i\" -ge \"$max\" ]; do sleep 1; i=$((i+1)); done; if [ \"$i\" -ge \"$max\" ]; then echo 'MySQL nie uruchomił się w czasie' >&2; fi; export MYSQL_PWD={root_password}; exec mysql -h127.0.0.1 -uroot {database}"
        ]
    },
    
    "description": "MySQL labdb (root)"
}
