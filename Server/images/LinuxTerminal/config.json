{
    "session": {
        "base_name": "ubuntu_shell",
        "image": "ubuntu:22.04",
        "seed_dir": "shared",
        "mount_path": "/shared_data",
        "workdir": "/shared_data",
        "hostname_template": "{user}-lab",
        "run_command": [
            "run",
            "-d",
            "--name",
            "{container_name}",
            "--hostname",
            "{hostname}",
            "-v",
            "{data_volume}:{mount_path}",
            "{image}",
            "sleep",
            "infinity"
        ],
        "attach_command": [
            "/bin/bash"
        ]
    },
    
    "description": "Powłoka bash (Ubuntu)"
}
